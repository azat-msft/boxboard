<Window x:Class="Boxboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Boxboard.Models"
        Title="Boxboard" Icon="/Boxboard;component/Assets/Boxboard.ico"
        Width="680" Height="850" MinWidth="560" MinHeight="510"
        FontFamily="Segoe UI" FontSize="12" Background="#EEF2F5"
        Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed" Activated="Window_Activated">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="QuadrantsPanel">
            <UniformGrid Rows="2" Columns="2" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="SideBySidePanel">
            <UniformGrid Rows="1" Columns="2" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="SingleWindowPanel">
            <UniformGrid Rows="1" Columns="1" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="LargeAndStackedPanel">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            </Grid>
        </ItemsPanelTemplate>
        <Style x:Key="LargeAndStackedItems" TargetType="ContentPresenter">
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                    <Setter Property="Grid.Row" Value="0" />
                    <Setter Property="Grid.RowSpan" Value="2" />
                    <Setter Property="Grid.Column" Value="0" />
                </Trigger>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Grid.Row" Value="0" />
                    <Setter Property="Grid.Column" Value="1" />
                </Trigger>
                <Trigger Property="ItemsControl.AlternationIndex" Value="2">
                    <Setter Property="Grid.Row" Value="1" />
                    <Setter Property="Grid.Column" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DesktopSlots" TargetType="ItemsControl">
            <Setter Property="ItemsPanel" Value="{StaticResource QuadrantsPanel}" />
            <Setter Property="Height" Value="126" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Mode}" Value="{x:Static models:WindowLayoutMode.SideBySide}">
                    <Setter Property="ItemsPanel" Value="{StaticResource SideBySidePanel}" />
                    <Setter Property="Height" Value="65" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Mode}" Value="{x:Static models:WindowLayoutMode.LargeLeftTwoStackedRight}">
                    <Setter Property="ItemsPanel" Value="{StaticResource LargeAndStackedPanel}" />
                    <Setter Property="ItemContainerStyle" Value="{StaticResource LargeAndStackedItems}" />
                    <Setter Property="Height" Value="127" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Mode}" Value="{x:Static models:WindowLayoutMode.SingleWindow}">
                    <Setter Property="ItemsPanel" Value="{StaticResource SingleWindowPanel}" />
                    <Setter Property="Height" Value="65" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Border Background="White" CornerRadius="14" Margin="12" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="4,0,2,11">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="RefreshButton" Content="Refresh" Click="Refresh_Click"
                                MinHeight="28" Padding="9,4" Margin="0,0,5,0" />
                        <Button x:Name="LogButton" Content="Log" Click="Log_Click"
                                MinHeight="28" Padding="9,4" Margin="0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Boxboard" FontSize="21" FontWeight="Bold" Foreground="#253544" />
                        <TextBlock x:Name="StatusText" FontSize="11" Foreground="#687B89" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </DockPanel>
                <TextBlock x:Name="ErrorText" Grid.Row="1" Margin="4,0,4,8"
                           Foreground="#A12222" TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                           AutomationProperties.LiveSetting="Assertive" />
                <Border Grid.Row="2" Background="#F6F9FB" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Unassigned Dev Boxes" FontWeight="SemiBold" Foreground="#253544" />
                        <TextBlock Text="Drag a machine into a slot. Assigned tiles can be moved too."
                                   FontSize="11" Foreground="#687B89" Margin="0,2,0,7" />
                        <ListBox x:Name="MachineList" AutomationProperties.Name="Unassigned Dev Boxes"
                                 BorderThickness="0" Background="Transparent" MinHeight="0" Padding="0"
                                 MaxHeight="104" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 PreviewMouseLeftButtonDown="MachineList_MouseDown"
                                 PreviewMouseMove="MachineList_MouseMove">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#DCE6EB" BorderThickness="1" Background="White"
                                            CornerRadius="7" Margin="0,0,6,6" Padding="7"
                                            ToolTip="{Binding Details}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="22" Height="22" CornerRadius="4" Background="#2074B4">
                                                <UniformGrid Rows="2" Columns="2" Margin="5">
                                                    <Rectangle Fill="White" Margin="1" /><Rectangle Fill="White" Margin="1" />
                                                    <Rectangle Fill="White" Margin="1" /><Rectangle Fill="White" Margin="1" />
                                                </UniformGrid>
                                            </Border>
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="7,0,0,0"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
                <ScrollViewer x:Name="DesktopScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="DesktopCards">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E0E7EC" BorderThickness="1" Background="White"
                                        CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="1,0,1,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="#253544" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1" Width="122" MinHeight="27" Padding="5,2"
                                                      Margin="0,0,9,0" ItemsSource="{Binding Modes}"
                                                      DisplayMemberPath="Name"
                                                      SelectedItem="{Binding SelectedMode, Mode=OneWay}"
                                                      IsEnabled="{Binding CanEdit}"
                                                      SelectionChanged="CardLayout_Changed"
                                                      AutomationProperties.Name="Window layout" />
                                            <CheckBox Grid.Column="2" Content="Keep on" Margin="0,0,9,0"
                                                      VerticalAlignment="Center" IsEnabled="{Binding CanEdit}"
                                                      IsChecked="{Binding KeepConnected, Mode=OneWay}"
                                                      Checked="CardKeepConnected_Changed"
                                                      Unchecked="CardKeepConnected_Changed"
                                                      ToolTip="Relaunch missing assigned clients after a short delay." />
                                            <Button Grid.Column="3" Content="Re-apply" Click="CardApply_Click"
                                                    IsEnabled="{Binding CanEdit}"
                                                    MinHeight="27" Padding="10,3" Margin="0"
                                                    Background="#DCECF9"
                                                    ToolTip="Reposition all assigned clients and retry missing ones." />
                                        </Grid>
                                        <TextBlock Text="Layout not applied. Resolve the error and re-apply."
                                                   Foreground="#7653A3" FontSize="11" Margin="2,0,0,5">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PendingApply}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding Cells}" AlternationCount="4"
                                                      Style="{StaticResource DesktopSlots}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="SlotTile" Margin="0,0,7,7" CornerRadius="7"
                                                            BorderBrush="#E2E8ED" BorderThickness="1" Background="#F9FBFC"
                                                            AllowDrop="True" DragOver="Cell_DragOver" Drop="Cell_Drop"
                                                            PreviewMouseLeftButtonDown="Cell_MouseDown"
                                                            PreviewMouseMove="Cell_MouseMove"
                                                            ToolTip="{Binding Status}"
                                                            AutomationProperties.Name="{Binding Name}">
                                                        <Grid>
                                                            <StackPanel x:Name="AssignedContent" Orientation="Horizontal"
                                                                        VerticalAlignment="Center" Margin="10,0,26,0">
                                                                <Border Width="24" Height="24" CornerRadius="4" Background="#2074B4"
                                                                        VerticalAlignment="Top" Margin="0,1,8,0">
                                                                    <UniformGrid Rows="2" Columns="2" Margin="5">
                                                                        <Rectangle Fill="White" Margin="1" /><Rectangle Fill="White" Margin="1" />
                                                                        <Rectangle Fill="White" Margin="1" /><Rectangle Fill="White" Margin="1" />
                                                                    </UniformGrid>
                                                                </Border>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding MachineName}" FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis" Foreground="#253544" />
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Ellipse Width="7" Height="7" Margin="1,0,6,0"
                                                                                 Fill="{Binding StateBrush}"
                                                                                 VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding StateText}" FontSize="11"
                                                                                   Foreground="#687B89" TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <Button x:Name="EmptyContent" Content="+  Drop Dev Box"
                                                                    Click="AssignSelected_Click" Visibility="Collapsed"
                                                                    Foreground="#3B596F" Background="Transparent"
                                                                    BorderThickness="0" MinHeight="24" Padding="4"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <Button x:Name="SlotMenuButton" Content="..." Click="More_Click"
                                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                    MinWidth="24" Width="24" Height="22" MinHeight="22"
                                                                    Padding="0" Margin="0,1,3,0" Background="Transparent"
                                                                    BorderThickness="0" ToolTip="Slot actions"
                                                                    AutomationProperties.Name="Slot actions">
                                                                <Button.ContextMenu>
                                                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                                        <MenuItem Header="Connect / Reconnect" Click="Connect_Click"
                                                                                  IsEnabled="{Binding CanConnect}" />
                                                                        <MenuItem Header="Bind an existing window..." Click="BindPicker_Click"
                                                                                  IsEnabled="{Binding CanBind}" />
                                                                        <Separator />
                                                                        <MenuItem Header="Clear assignment" Click="Clear_Click" />
                                                                    </ContextMenu>
                                                                </Button.ContextMenu>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsAssigned}" Value="False">
                                                            <Setter TargetName="AssignedContent" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="EmptyContent" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="SlotMenuButton" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="SlotTile" Property="BorderBrush" Value="#A6BBC9" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding HiddenAssignments}" FontSize="11" Margin="2,2,0,0"
                                                   Foreground="#687B89" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding HiddenAssignments}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasHiddenAssignments}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Grid.Row="4" Text="Window open means a client exists; it does not prove RDP is connected."
                           FontSize="11" Foreground="#687B89" Margin="3,4,0,0" />
            </Grid>
        </Border>
        <Border x:Name="MoveOverlay" Background="#EE18314F" Visibility="Collapsed"
                KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="MoveOverlay_KeyDown">
            <Border Background="White" CornerRadius="8" Padding="24" MaxWidth="540" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Move assignment?" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock x:Name="MoveText" Margin="0,15,0,24" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelMoveButton" Content="Cancel" Click="CancelMove_Click" />
                        <Button Content="Move assignment" Click="ConfirmMove_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
